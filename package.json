{
  "name": "metalcharts",
  "version": "0.1.0",
  "description": "JavaScript and TypeScript client for the MetalCharts API: live and historical gold, silver, platinum, palladium, copper and base metal prices, plus COMEX, LBMA, Shanghai and CFTC data. Zero dependencies.",
  "keywords": [
    "metals api",
    "gold price api",
    "silver price api",
    "gold price",
    "silver price",
    "precious metals",
    "spot price",
    "xau",
    "xag",
    "comex",
    "lbma",
    "commodities",
    "server-sent events",
    "metalcharts"
  ],
  "homepage": "https://metalcharts.org/metals-api",
  "bugs": {
    "url": "https://github.com/maxcash2147/metalcharts-js/issues",
    "email": "support@metalcharts.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxcash2147/metalcharts-js.git"
  },
  "license": "MIT",
  "author": "MetalCharts <support@metalcharts.org> (https://metalcharts.org)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "typescript": "^5.9"
  }
}
